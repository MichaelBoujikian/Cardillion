# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
# Used only by the art tools (see docs/art-pipeline.md). The game itself needs no keys.
OPENAI_API_KEY=
# Runway developer API (image-to-video), from the API Keys tab at https://dev.runwayml.com/ — see docs/runway-api.md
RUNWAYML_API_SECRET=
# No tool reads RUNWAYML_API_SECRET yet — docs/runway-api.md is a plan.
#
# The two below are read from the process environment, not from this file (only
# tools/gen-art.mjs parses .env). Set them in the shell if the defaults are wrong.
# COMFYUI_DIR — the ComfyUI portable folder, read by tools/lib/comfy.mjs
#               (default C:\Users\smite\ComfyUI_windows_portable)
# FFMPEG      — path to ffmpeg.exe, read by tools/art-video.mjs
#               (default art/out/bin/ffmpeg.exe, then ffmpeg on PATH)
