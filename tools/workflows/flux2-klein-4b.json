{
  "$comment": "ComfyUI API-format graph: FLUX.2 [klein] 4B (distilled, fp8, Apache-2.0) for text-to-image and for editing. tools/gen-image-local.mjs fills prompt, seed, size; for an edit it wires the uploaded image through 4/8/11/12, otherwise it removes those nodes and feeds 9/10 straight into 15. From the official image_flux2_klein_image_edit_4b_distilled template: euler, 4 steps, cfg 1.",
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "flux-2-klein-4b-fp8.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default" }
  },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "flux2-vae.safetensors" } },
  "4": { "class_type": "LoadImage", "inputs": { "image": "" } },
  "7": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "8": { "class_type": "VAEEncode", "inputs": { "pixels": ["4", 0], "vae": ["3", 0] } },
  "9": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "" } },
  "10": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["9", 0] } },
  "11": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["9", 0], "latent": ["8", 0] }
  },
  "12": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["10", 0], "latent": ["8", 0] }
  },
  "13": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "14": { "class_type": "Flux2Scheduler", "inputs": { "steps": 4, "width": 1024, "height": 1024 } },
  "15": {
    "class_type": "CFGGuider",
    "inputs": { "model": ["1", 0], "positive": ["11", 0], "negative": ["12", 0], "cfg": 1 }
  },
  "16": { "class_type": "RandomNoise", "inputs": { "noise_seed": 0 } },
  "17": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["16", 0],
      "guider": ["15", 0],
      "sampler": ["13", 0],
      "sigmas": ["14", 0],
      "latent_image": ["7", 0]
    }
  },
  "18": { "class_type": "VAEDecode", "inputs": { "samples": ["17", 0], "vae": ["3", 0] } },
  "19": {
    "class_type": "SaveImage",
    "inputs": { "images": ["18", 0], "filename_prefix": "cardillion" }
  }
}
